<!-- 首页：实时位置地图 -->
<view class="page">
  <!-- 顶部状态栏 -->
  <view class="status-bar">
    <text class="update-time">⏰ 最后更新：{{lastUpdate}}</text>
    <text class="battery">🔋 {{battery}}%</text>
  </view>

  <!-- 地图 -->
  <map 
    id="map"
    class="map-area"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    markers="{{markers}}"
    scale="{{scale}}"
    show-location
    enable-zoom
  ></map>

  <!-- 当前位置文字 -->
  <view class="location-label">
    <text class="location-icon">📍</text>
    <text class="location-text">{{deviceName}} {{locationText}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="action-bar">
    <button class="btn btn-primary" bindtap="onRefresh">📍 刷新定位</button>
    <button class="btn btn-secondary" bindtap="onFence">🏠 设置围栏</button>
  </view>

  <!-- 设备列表 -->
  <view class="device-list">
    <view class="device-card" wx:for="{{deviceList}}" wx:key="id" bindtap="onDeviceTap" data-id="{{item.id}}">
      <text class="device-icon">{{item.icon}}</text>
      <view class="device-info">
        <text class="device-name">{{item.name}}</text>
        <text class="device-status {{item.online ? 'online' : 'offline'}}">{{item.online ? '🟢 在线' : '🔴 离线'}}</text>
      </view>
      <text class="device-arrow">›</text>
    </view>
    <view class="device-card add-device" bindtap="onAddDevice">
      <text class="device-icon">➕</text>
      <text class="device-name">添加设备</text>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="tab-bar">
    <view class="tab-item active">
      <text>📍</text>
      <text>位置</text>
    </view>
    <view class="tab-item">
      <text>📋</text>
      <text>设备</text>
    </view>
    <view class="tab-item">
      <text>👤</text>
      <text>我的</text>
    </view>
  </view>
</view>
