<!-- SOS 紧急告警页 -->
<view class="sos-page">
  <!-- 顶部红色告警 -->
  <view class="sos-banner">
    <view class="sos-icon">⚠️</view>
    <text class="sos-title">紧急求助</text>
    <text class="sos-time">{{time}}前</text>
  </view>

  <!-- 位置信息 -->
  <view class="location-card">
    <text class="loc-label">📍 最后位置</text>
    <text class="loc-address">{{address}}</text>
    <text class="loc-detail">{{detail}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="sos-actions">
    <button class="action-btn navigate-btn" bindtap="onNavigate">
      🚗 导航去找
    </button>
    <button class="action-btn call-btn" bindtap="onCall">
      📞 打电话
    </button>
  </view>

  <!-- 确认按钮 -->
  <button class="safe-btn" bindtap="onSafe">
    ✅ 已确认平安
  </button>
</view>
