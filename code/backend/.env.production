# ============================================================
# KeepSafe Backend - Production Environment Variables
# ============================================================
# Copy this to .env and replace all CHANGEME values with real secrets.
# DO NOT commit .env to git.
#
# To generate secrets:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
DEV_MODE=false
APP_VERSION=latest

# JWT (REQUIRED)
JWT_SECRET=CHANGE...ME

# PostgreSQL (also used by docker-compose postgres container)
POSTGRES_DB=keepsafe
POSTGRES_USER=keepsafe
POSTGRES_PASSWORD=CHANGE...ME

# App DB connection (inside container, host=postgres from compose)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=keepsafe
DB_USER=keepsafe
DB_PASSWORD=CHANGE...ME

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE...ME

# EMQX MQTT Broker
EMQX_HOST=emqx
EMQX_PORT=1883
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=CHANGE...ME

# Push Notifications - put credential files under ./credentials/
FCM_CREDENTIALS_PATH=/app/credentials/firebase-service-account.json
APNS_KEY_PATH=/app/credentials/apns-key.p8
APNS_KEY_ID=CHANGE...ME
APNS_TEAM_ID=CHANGE...ME
APNS_TOPIC=com.keepsafe.app

# LBS - OpenCellID
LBS_SOURCE=opencellid
OPENCELLID_API_KEY=CHANGE...ME

# MQTT Topics
MQTT_TOPIC_LOCATION=keepsafe/v1/{device_id}/location
MQTT_TOPIC_HEARTBEAT=keepsafe/v1/{device_id}/heartbeat
MQTT_TOPIC_SOS=keepsafe/v1/{device_id}/sos
MQTT_TOPIC_LOW_BATTERY=keepsafe/v1/{device_id}/alert/low_battery
MQTT_TOPIC_VERSION=keepsafe/v1/{device_id}/version
