# ============================================================
# KeepSafe Backend — Environment Variable Template
# ============================================================
# Copy this to .env and fill in the values

# ── Database ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keepsafe
DB_USER=keepsafe
DB_PASSWORD={{PLACEHOLDER_DB_PASSWORD}}

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD={{PLACEHOLDER_REDIS_PASSWORD}}

# ── EMQX ──
EMQX_HOST=localhost
EMQX_PORT=1883
EMQX_DASHBOARD_PASSWORD={{PLACEHOLDER_EMQX_DASHBOARD_PASSWORD}}

# ── Push Notifications ──
FCM_CREDENTIALS_PATH=./credentials/firebase-service-account.json
APNS_KEY_PATH=./credentials/apns-key.p8
APNS_KEY_ID={{PLACEHOLDER_APNS_KEY_ID}}
APNS_TEAM_ID={{PLACEHOLDER_APNS_TEAM_ID}}
APNS_TOPIC=com.keepsafe.app

# ── LBS Resolution ──
OPENCELLID_API_KEY={{PLACEHOLDER_OPENCELLID_API_KEY}}

# ── FastAPI ──
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
