# ============================================================
# KeepSafe Backend — .dockerignore
# ============================================================

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
*.egg

# Environment
.env
.env.local
.env.*.local

# Version control
.git/
.gitignore
.gitattributes

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
.dockerignore

# Credentials (must be mounted at runtime, not baked into image)
credentials/*.json
credentials/*.p8

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/
