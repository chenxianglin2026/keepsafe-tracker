/** KeepSafe 全局样式 */

/* 主题色 */
page {
  --primary: #4FACFE;
  --primary-dark: #3A8DD9;
  --danger: #FF4757;
  --warning: #FFA502;
  --success: #2ED573;
  --bg-dark: #0F0F23;
  --bg-card: #1A1A2E;
  --bg-surface: #16213E;
  --text-primary: #FFFFFF;
  --text-secondary: #A0A0B8;
  --text-muted: #6C6C80;
  --border-color: #2A2A4A;
  --safe-bottom: env(safe-area-inset-bottom, 0px);

  background-color: var(--bg-dark);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 通用卡片样式 */
.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid var(--border-color);
}

/* 按钮基础样式 */
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  width: 100%;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-danger {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  background: var(--danger);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  width: 100%;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  background: transparent;
  color: var(--primary);
  font-size: 28rpx;
  border: 2rpx solid var(--primary);
  width: 100%;
}

/* 输入框 */
.input-field {
  height: 88rpx;
  background: var(--bg-surface);
  border-radius: 16rpx;
  padding: 0 24rpx;
  color: var(--text-primary);
  font-size: 28rpx;
  border: 2rpx solid var(--border-color);
  width: 100%;
  box-sizing: border-box;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-success {
  background: rgba(46, 213, 115, 0.15);
  color: var(--success);
}

.tag-warning {
  background: rgba(255, 165, 2, 0.15);
  color: var(--warning);
}

.tag-danger {
  background: rgba(255, 71, 87, 0.15);
  color: var(--danger);
}

/* Toast / 提示 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  z-index: 9999;
  pointer-events: none;
}

/* 加载动画 */
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  color: var(--text-muted);
}

.empty-state text {
  margin-top: 24rpx;
  font-size: 28rpx;
}
