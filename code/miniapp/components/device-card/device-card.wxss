/** 设备状态卡片组件样式 */
.device-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 12rpx 24rpx;
  border: 1rpx solid var(--border-color);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.device-info {
  flex: 1;
  margin-right: 16rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  line-height: 1.4;
}

.device-id-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.device-id-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.device-id {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-family: 'Courier New', monospace;
}

.device-status {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.device-body {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(42, 42, 74, 0.5);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-primary);
  flex: 1;
  text-align: right;
}

.info-value.highlight {
  color: var(--primary);
  font-weight: 500;
}

.battery-bar {
  flex: 1;
  height: 16rpx;
  background: var(--bg-surface);
  border-radius: 8rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.battery-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.device-footer {
  display: flex;
  gap: 12rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--bg-surface);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.action-btn:active {
  opacity: 0.7;
  background: var(--border-color);
}

.locate-btn {
  color: var(--primary);
}

.fence-btn {
  color: var(--warning);
}

.share-btn {
  color: var(--success);
}
