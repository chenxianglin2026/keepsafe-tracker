<!-- 告警列表页面 -->
<view class="page-alerts">

  <!-- 告警类型筛选 -->
  <view class="filter-bar">
    <view
      class="filter-item {{currentFilter === 'all' ? 'active' : ''}}"
      data-type="all"
      bindtap="onFilterChange"
    >
      <text>全部</text>
    </view>
    <view
      class="filter-item {{currentFilter === 'sos' ? 'active' : ''}}"
      data-type="sos"
      bindtap="onFilterChange"
    >
      <text>SOS 求助</text>
    </view>
    <view
      class="filter-item {{currentFilter === 'fence' ? 'active' : ''}}"
      data-type="fence"
      bindtap="onFilterChange"
    >
      <text>围栏告警</text>
    </view>
    <view
      class="filter-item {{currentFilter === 'low_battery' ? 'active' : ''}}"
      data-type="low_battery"
      bindtap="onFilterChange"
    >
      <text>低电量</text>
    </view>
    <view
      class="filter-item {{currentFilter === 'offline' ? 'active' : ''}}"
      data-type="offline"
      bindtap="onFilterChange"
    >
      <text>设备离线</text>
    </view>
  </view>

  <!-- 全部已读 -->
  <view class="read-all-bar" wx:if="{{alertList.length > 0}}">
    <view class="read-all-btn" bindtap="onMarkAllRead">
      <text>✓ 全部标记为已读</text>
    </view>
  </view>

  <!-- 告警列表 -->
  <scroll-view
    class="alert-scroll"
    scroll-y
    bindscrolltolower="onLoadMore"
    lower-threshold="100"
  >
    <view class="alert-list">
      <view
        class="alert-item {{!item.is_read ? 'unread' : ''}}"
        wx:for="{{alertList}}"
        wx:key="id"
        bindtap="onAlertTap"
        data-item="{{item}}"
      >
        <view class="alert-icon">
          <text wx:if="{{item.type === 'sos'}}">🆘</text>
          <text wx:elif="{{item.type === 'fence'}}">⭕</text>
          <text wx:elif="{{item.type === 'low_battery'}}">🔋</text>
          <text wx:elif="{{item.type === 'offline'}}">📴</text>
          <text wx:else>🔔</text>
        </view>
        <view class="alert-content">
          <view class="alert-header-row">
            <text class="alert-type-tag {{'tag-' + item.type}}">{{alertTypeName(item.type)}}</text>
            <text class="alert-time">{{formatTime(item.created_at)}}</text>
          </view>
          <text class="alert-title">{{item.title || item.message || '告警'}}</text>
          <text class="alert-desc" wx:if="{{item.device_name}}">
            设备：{{item.device_name}}
          </text>
          <text class="alert-desc" wx:if="{{item.location_desc}}">
            {{item.location_desc}}
          </text>
        </view>
        <view class="alert-status">
          <view class="unread-dot" wx:if="{{!item.is_read}}"></view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <view class="loading-spinner"></view>
      <text class="load-more-text">加载更多...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && alertList.length > 0}}">
      <text class="no-more-text">— 没有更多告警 —</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && alertList.length === 0}}">
      <view class="empty-icon">🔔</view>
      <text class="empty-title">暂无告警</text>
      <text class="empty-desc">所有设备一切正常</text>
    </view>

    <!-- 加载中 -->
    <view class="loading-state" wx:if="{{loading && alertList.length === 0}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>
  </scroll-view>
</view>
