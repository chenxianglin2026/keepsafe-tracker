<!-- SOS 告警详情页 (增强版) -->
<view class="page-sos">

  <!-- 地图区域 (使用 map-locator 组件) -->
  <view class="map-wrap">
    <map-locator
      id="sosMapLocator"
      latitude="{{latitude}}"
      longitude="{{longitude}}"
      scale="{{scale}}"
      markers="{{markers}}"
      show-zoom="{{true}}"
      bind:markertap="onMapMarkerTap"
    />
  </view>

  <!-- SOS 紧急横幅 -->
  <view class="sos-banner">
    <view class="sos-badge">🆘 SOS 求助</view>
    <text class="sos-time">{{timeText}}</text>
  </view>

  <!-- 追踪状态栏 -->
  <view class="tracking-bar" wx:if="{{tracking}}">
    <view class="tracking-pulse"></view>
    <text class="tracking-text">实时追踪中 — 每 10 秒刷新位置</text>
  </view>

  <!-- 设备信息卡片 -->
  <view class="info-card">
    <view class="info-row">
      <text class="info-label">设备名称</text>
      <text class="info-value">{{deviceName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">设备 ID</text>
      <text class="info-value mono">{{deviceId}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">位置</text>
      <text class="info-value addr">{{address || '获取位置中...'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">电量</text>
      <view class="battery-row">
        <view class="battery-bar small">
          <view class="battery-fill" style="width: {{battery}}%; background: {{batteryColor}};"></view>
        </view>
        <text class="info-value">{{battery}}%</text>
      </view>
    </view>
    <view class="info-row" wx:if="{{sosEventsCount > 0}}">
      <text class="info-label">SOS 历史</text>
      <text class="info-value highlight">共 {{sosEventsCount}} 次</text>
    </view>
  </view>

  <!-- 操作按钮组 -->
  <view class="action-section">
    <view class="btn-primary call-btn" bindtap="onCallDevice">
      <text>📞 紧急联系</text>
    </view>

    <!-- 追踪按钮 -->
    <view class="btn-tracking {{tracking ? 'active' : ''}}" bindtap="{{tracking ? 'onStopTracking' : 'onStartTracking'}}">
      <text wx:if="{{!tracking}}">📍 开始追踪</text>
      <text wx:else>⏹️ 停止追踪</text>
    </view>

    <view class="action-row">
      <view class="btn-outline nav-btn" bindtap="onNavigate">
        <text>🗺️ 导航前往</text>
      </view>
      <view class="btn-outline ack-btn" bindtap="onAcknowledge">
        <text>✓ 确认收到</text>
      </view>
    </view>
  </view>

  <!-- 紧急号码快捷拨号 -->
  <view class="emergency-contacts">
    <view class="contact-card" bindtap="onCallPolice">
      <text class="contact-icon">🚔</text>
      <text class="contact-label">报警 110</text>
    </view>
    <view class="contact-card" bindtap="onCallAmbulance">
      <text class="contact-icon">🚑</text>
      <text class="contact-label">急救 120</text>
    </view>
    <view class="contact-card" bindtap="onCallFire">
      <text class="contact-icon">🚒</text>
      <text class="contact-label">火警 119</text>
    </view>
  </view>

  <!-- 提示 -->
  <view class="sos-tip">
    <text>🕐 请尽快联系使用者确认安全。如情况紧急，建议直接报警。</text>
  </view>
</view>
