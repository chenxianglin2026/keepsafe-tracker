/** SOS 告警详情页样式 */

.page-sos {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

/* 地图 */
.map-wrap {
  width: 100%;
  height: 480rpx;
}

.map {
  width: 100%;
  height: 100%;
}

/* SOS 横幅 */
.sos-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, rgba(255,71,87,0.2), rgba(255,71,87,0.05));
  border-bottom: 2rpx solid rgba(255,71,87,0.15);
}

.sos-badge {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF4757;
}

.sos-time {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 设备信息卡片 */
.info-card {
  background: var(--bg-card);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--border-color);
}

.info-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(42,42,74,0.4);
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
}

.battery-row {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.battery-bar.small {
  width: 100rpx;
  height: 14rpx;
  background: var(--bg-surface);
  border-radius: 7rpx;
  overflow: hidden;
}

.battery-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.3s;
}

/* 操作按钮 */
.action-section {
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.call-btn {
  background: linear-gradient(135deg, #FF4757, #FF6B81);
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
}

.nav-btn {
  height: 88rpx;
  border-color: var(--primary);
  color: var(--primary);
}

.ack-btn {
  height: 80rpx;
  border-color: var(--success);
  color: var(--success);
  font-size: 28rpx;
}

/* 提示 */
.sos-tip {
  padding: 24rpx 40rpx;
  text-align: center;
}

.sos-tip text {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}
