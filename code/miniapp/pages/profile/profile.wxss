/** 我的页面样式 - 适老化增强版 */

.page-profile {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 用户卡片 - 适老化：更大头像、更大字号、更高对比度 */
.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: var(--bg-card);
  margin: 20rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--border-color);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(79, 172, 254, 0.5);
  margin-right: 28rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.user-desc {
  font-size: 28rpx;
  color: var(--text-primary);
  opacity: 0.75;
}

/* 区块标题 - 适老化：更大字号、更高对比度 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 32rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.section-action {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--primary);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(79, 172, 254, 0.1);
}

.section-action:active {
  opacity: 0.7;
}

/* 空设备 */
.empty-devices {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx;
  color: var(--text-primary);
  opacity: 0.65;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
}

/* 设置项 - 适老化：更大点击区域、更大字号、更高对比度 */
.settings-section {
  background: var(--bg-card);
  border-radius: 24rpx;
  margin: 12rpx 24rpx;
  border: 2rpx solid var(--border-color);
  overflow: hidden;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx;
  border-bottom: 2rpx solid var(--border-color);
  min-height: 100rpx;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: rgba(79, 172, 254, 0.06);
}

.setting-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.setting-icon {
  font-size: 40rpx;
  width: 48rpx;
  text-align: center;
}

.setting-label {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.setting-value {
  font-size: 28rpx;
  color: var(--text-primary);
  opacity: 0.7;
  margin-right: 8rpx;
}

.setting-arrow {
  font-size: 36rpx;
  color: var(--text-primary);
  opacity: 0.5;
  font-weight: 400;
}

/* 退出登录 - 适老化：更大按钮、更大点击区域 */
.logout-section {
  padding: 60rpx 60rpx;
}

.logout-btn {
  border-color: rgba(255, 71, 87, 0.5);
  border-width: 2rpx;
  color: var(--danger);
  padding: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  border-radius: 16rpx;
}

/* 绑定设备弹窗 - 适老化：更大字号、更大点击区域 */
.bind-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.bind-panel {
  width: 100%;
  background: var(--bg-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 36rpx;
  padding-bottom: calc(48rpx + var(--safe-bottom));
}

.bind-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 36rpx;
}

.bind-title {
  font-size: 40rpx;
  font-weight: 700;
}

.bind-close {
  font-size: 40rpx;
  color: var(--text-primary);
  opacity: 0.6;
  padding: 16rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-desc {
  font-size: 30rpx;
  color: var(--text-primary);
  opacity: 0.75;
  margin-bottom: 28rpx;
  display: block;
}

.bind-input {
  font-size: 48rpx;
  letter-spacing: 16rpx;
  text-align: center;
  font-weight: 700;
  padding: 20rpx;
}

.bind-name-input {
  margin-top: 20rpx;
}

.bind-footer {
  margin-top: 40rpx;
}
